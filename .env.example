# Copy locally; never commit a populated .env file.
# Authorized resource IDs belong in config/resource-registry.json, not secret values.
# Do not populate future secret names for the currently disabled research service.
GARDEN_ENV=local
PUBLIC_BASE_URL=http://localhost:3000
RESEARCH_BASE_URL=http://localhost:3001
ENABLE_RESEARCH=false
ENABLE_ASSISTANT=false
ENABLE_DONATIONS=false
ENABLE_GOVERNMENT=false

# Names for future explicitly authorized local research integration:
GARDEN_LOCAL_RESEARCH_DATABASE_URL=
GARDEN_LOCAL_MIGRATION_DATABASE_URL=
GARDEN_LOCAL_IDENTITY_CLIENT_SECRET=
GARDEN_LOCAL_SESSION_SECRET=
GARDEN_LOCAL_OBJECT_STORAGE_ACCESS_KEY_ID=
GARDEN_LOCAL_OBJECT_STORAGE_SECRET_ACCESS_KEY=

# Each real environment uses its own complete prefix and provider secret store.
# GARDEN_CI_RESEARCH_DATABASE_URL -- loopback/synthetic test data only
# GARDEN_PREVIEW_* -- never production credentials; research activation denied
# GARDEN_STAGING_RESEARCH_DATABASE_URL
# GARDEN_STAGING_MIGRATION_DATABASE_URL
# GARDEN_PRODUCTION_RESEARCH_DATABASE_URL
# GARDEN_PRODUCTION_MIGRATION_DATABASE_URL
# GARDEN_PRODUCTION_IDENTITY_CLIENT_SECRET
# GARDEN_PRODUCTION_SESSION_SECRET
# NEON_PROJECT_ID must match the authorized project when research is activated.
# Public app builds receive NO private database, identity or storage credentials.
